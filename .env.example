# Application Settings
APP_NAME=EvidenceGuard
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-super-secret-key-32-chars

# Database Configuration (PostgreSQL 17 + pgvector)
POSTGRES_USER=evidenceguard
POSTGRES_PASSWORD=evidenceguard_password
POSTGRES_DB=evidenceguard_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://evidenceguard:evidenceguard_password@localhost:5432/evidenceguard_db

# LLM Configuration (Local-First / OpenAI compatible)
LLM_PROVIDER=ollama  # options: ollama, openai, mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3:8b
OPENAI_API_KEY=not-needed-for-local

# Embedding Configuration
EMBEDDING_PROVIDER=mock  # options: mock, openai, ollama
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Document Storage
STORAGE_DIR=./uploads

# Admin Default Account (MVP)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password
